FORM ID MainForm AT (0 0 160 160) USABLE SAVEBEHIND MENUID MainFormMenuBar
BEGIN
  BUTTON "Start" ID MainStartButton AT (50 15 60 25) USABLE LEFTANCHOR FRAME FONT 2
  FIELD ID MainEntryField AT (7 148 70 12) USABLE LEFTALIGN EDITABLE UNDERLINED MULTIPLELINES FONT 0 MAXCHARS 80 AUTOSHIFT
  LABEL ">" ID MainPromptLabel AT (0 149) USABLE FONT 0
  BUTTON "" ID MainCRLFGraphicButton AT (78 147 10 10) USABLE LEFTANCHOR NOFRAME GRAPHICAL BITMAPID GoBitmapFamily
  BUTTON "" ID MainClearGraphicButton AT (90 147 10 10) USABLE LEFTANCHOR NOFRAME GRAPHICAL BITMAPID ClearBitmapFamily
  BUTTON "" ID MainPicButton AT (117 132 43 28) USABLE LEFTANCHOR NOFRAME FONT 0
  BUTTON "" ID MainNGraphicButton AT (10 132 11 10) USABLE LEFTANCHOR NOFRAME GRAPHICAL BITMAPID NBitmapFamily
  BUTTON "" ID MainSGraphicButton AT (20 132 11 10) USABLE LEFTANCHOR NOFRAME GRAPHICAL BITMAPID SBitmapFamily
  BUTTON "" ID MainEGraphicButton AT (40 132 11 10) USABLE LEFTANCHOR NOFRAME GRAPHICAL BITMAPID EBitmapFamily
  BUTTON "" ID MainWGraphicButton AT (30 132 11 10) USABLE LEFTANCHOR NOFRAME GRAPHICAL BITMAPID WBitmapFamily
  BUTTON "" ID MainIGraphicButton AT (50 132 11 10) USABLE LEFTANCHOR NOFRAME GRAPHICAL BITMAPID IBitmapFamily
  BUTTON "" ID MainNavigateGraphicButton AT (60 132 11 10) USABLE LEFTANCHOR NOFRAME GRAPHICAL BITMAPID NavigateBitmapFamily
  BUTTON "" ID MainWordsGraphicButton AT (70 132 11 10) USABLE LEFTANCHOR NOFRAME GRAPHICAL BITMAPID WordsBitmapFamily
  BUTTON "" ID MainNil3GraphicButton AT (80 132 11 10) NONUSABLE LEFTANCHOR NOFRAME GRAPHICAL BITMAPID NilBitmapFamily
  BUTTON "" ID MainLoadGraphicButton AT (90 132 11 10) USABLE LEFTANCHOR NOFRAME GRAPHICAL BITMAPID LoadBitmapFamily
  BUTTON "" ID MainSaveGraphicButton AT (100 132 11 10) USABLE LEFTANCHOR NOFRAME GRAPHICAL BITMAPID SaveBitmapFamily
  BUTTON "" ID MainLGraphicButton AT (0 132 11 10) USABLE LEFTANCHOR NOFRAME GRAPHICAL BITMAPID LBitmapFamily
  LIST "" ID MainPopList AT (81 103 78 55) NONUSABLE FONT 0 VISIBLEITEMS 5
  CHECKBOX "Tiny Fonts" ID MainTinyCheckbox AT (41 71 85 12) USABLE GROUP 1 FONT 0
  CHECKBOX "Medium Fonts" ID MainMediumCheckbox AT (41 59 85 12) USABLE CHECKED GROUP 1 FONT 0
  CHECKBOX "Normal Fonts" ID MainNormalCheckbox AT (41 47 85 12) USABLE GROUP 1 FONT 0
  REPEATBUTTON "\x01" ID MainScrollUpRepeating AT (101 145 10 6) USABLE LEFTANCHOR NOFRAME FONT 5
  REPEATBUTTON "\x02" ID MainScrollDownRepeating AT (101 152 10 6) USABLE LEFTANCHOR NOFRAME FONT 5
  CHECKBOX "ZCode Screen" ID MainFullscreenCheckbox AT (41 86 115 12) USABLE GROUP 0 FONT 0
END

FORM ID AboutForm AT (2 2 156 156) USABLE MODAL SAVEBEHIND
BEGIN
  TITLE "Kronos"
  LABEL "An interactive fiction" ID AboutText1Label AT (CENTER 17) USABLE FONT 0
  LABEL "interpreter for Palm OS" AUTOID AT (CENTER PREVBOTTOM) USABLE FONT 0
  LABEL "by Jeff Mitchell (Codejedi)" ID AboutUnnamed1101Label AT (CENTER PREVBOTTOM) USABLE FONT 0
  LABEL "\"Magnetic\" by Niclas Karlsson" ID AboutUnnamed1104Label AT (CENTER PREVBOTTOM+6) USABLE FONT 0
  LABEL "\"Frotz\" by Stefan Jokisch" ID AboutUnnamed1108Label AT (CENTER PREVBOTTOM) USABLE FONT 0
  LABEL "\"ScottFree\" by Alan Cox" ID AboutUnnamed1109Label AT (CENTER PREVBOTTOM) USABLE FONT 0
  LABEL "\"Level9\" by Glen Summers & others" AUTOID AT (CENTER PREVBOTTOM) USABLE FONT 0
  LABEL "Free software under the GNU GPL" AUTOID AT (CENTER PREVBOTTOM+6) USABLE FONT 0
  BUTTON "OK" ID AboutOKButton AT (58 136 40 12) USABLE LEFTANCHOR FRAME FONT 0
  FIELD ID AboutVersionField AT (2 142 40 12) USABLE LEFTALIGN NONEDITABLE SINGLELINE FONT 0 MAXCHARS 20
  FIELD ID AboutDetailsField AT (106 142 50 12) USABLE RIGHTALIGN NONEDITABLE SINGLELINE FONT 0 MAXCHARS 80
END

FORM ID PicForm AT (0 13 160 147) USABLE MODAL SAVEBEHIND
BEGIN
  TITLE "Picture"
  BUTTON "OK" ID PicOKButton AT (119 129 36 12) USABLE LEFTANCHOR FRAME FONT 0
END

FORM ID PickerForm AT (0 0 160 160) USABLE SAVEBEHIND
BEGIN
  TITLE "Kronos"
  LABEL "Select a Game:" ID PickerUnnamed1301Label AT (39 21) USABLE FONT 2
  LIST "" ID PickerGamesList AT (5 40 150 88) USABLE FONT 0 VISIBLEITEMS 8
  BUTTON "Play" ID PickerPlayButton AT (64 138 36 12) USABLE LEFTANCHOR FRAME FONT 0
END

FORM ID MoreForm AT (2 133 110 24) USABLE MODAL SAVEBEHIND
BEGIN
  TITLE "MORE"
  BUTTON "... click here ..." ID MoreUnnamed1401Button AT (2 13 105 12) USABLE LEFTANCHOR NOFRAME FONT 0
END

FORM ID MapForm AT (2 22 156 136) USABLE MODAL SAVEBEHIND
BEGIN
  TITLE "Automap"
  BUTTON "OK" ID MapOKButton AT (4 120 20 12) USABLE LEFTANCHOR FRAME FONT 0
  FIELD ID MapWestField AT (8 53 36 25) USABLE LEFTALIGN NONEDITABLE MULTIPLELINES FONT 0 MAXCHARS 80
  FIELD ID MapEastField AT (112 53 36 25) USABLE LEFTALIGN NONEDITABLE MULTIPLELINES FONT 0 MAXCHARS 80
  FIELD ID MapSouthField AT (60 87 36 25) USABLE LEFTALIGN NONEDITABLE MULTIPLELINES FONT 0 MAXCHARS 80
  FIELD ID MapNorthwestField AT (8 19 36 25) USABLE LEFTALIGN NONEDITABLE MULTIPLELINES FONT 0 MAXCHARS 80
  FIELD ID MapNortheastField AT (112 19 36 25) USABLE LEFTALIGN NONEDITABLE MULTIPLELINES FONT 0 MAXCHARS 80
  FIELD ID MapNorthField AT (60 19 36 25) USABLE LEFTALIGN NONEDITABLE MULTIPLELINES FONT 0 MAXCHARS 80
  BUTTON "" ID MapSouthButton AT (58 84 40 30) USABLE LEFTANCHOR FRAME FONT 0
  BUTTON "" ID MapNorthButton AT (58 16 40 30) USABLE LEFTANCHOR FRAME FONT 0
  FIELD ID MapCenterField AT (59 53 36 25) USABLE LEFTALIGN NONEDITABLE MULTIPLELINES FONT 0 MAXCHARS 80
  BUTTON "Recenter" ID MapRecenterButton AT (29 120 42 12) USABLE LEFTANCHOR FRAME FONT 0
  BUTTON "" ID MapWestButton AT (6 50 40 30) USABLE LEFTANCHOR FRAME FONT 0
  BUTTON "" ID MapEastButton AT (110 50 40 30) USABLE LEFTANCHOR FRAME FONT 0
  FIELD ID MapSoutheastField AT (112 87 36 25) USABLE LEFTALIGN NONEDITABLE MULTIPLELINES FONT 0 MAXCHARS 80
  FIELD ID MapSouthwestField AT (8 87 36 25) USABLE LEFTALIGN NONEDITABLE MULTIPLELINES FONT 0 MAXCHARS 80
  BUTTON "" ID MapNorthwestButton AT (6 16 40 30) USABLE LEFTANCHOR FRAME FONT 0
  BUTTON "" ID MapNortheastButton AT (110 16 40 30) USABLE LEFTANCHOR FRAME FONT 0
  BUTTON "" ID MapSoutheastButton AT (110 85 40 30) USABLE LEFTANCHOR FRAME FONT 0
  BUTTON "" ID MapSouthwestButton AT (6 85 40 30) USABLE LEFTANCHOR FRAME FONT 0
  POPUPTRIGGER "?" ID MapFindPopTrigger AT (129 120 25 12) USABLE LEFTANCHOR FONT 0
  LIST "" ID MapFindList AT (53 68 100 66) NONUSABLE FONT 0 VISIBLEITEMS 6
  BUTTON "Up" ID MapUpButton AT (76 120 20 12) USABLE LEFTANCHOR FRAME FONT 0
  BUTTON "Dn" ID MapDownButton AT (101 120 20 12) USABLE LEFTANCHOR FRAME FONT 0
END

FORM ID NoteForm AT (2 2 156 156) USABLE MODAL SAVEBEHIND
BEGIN
  TITLE "Game Notes"
  BUTTON "OK" ID NoteOKButton AT (4 140 36 12) USABLE LEFTANCHOR FRAME FONT 0
  FIELD ID NoteNoteField AT (3 28 140 109) USABLE LEFTALIGN EDITABLE UNDERLINED MULTIPLELINES FONT 0 MAXCHARS 32000 AUTOSHIFT HASSCROLLBAR
  LABEL "Notes are stored on expansion cards" ID NoteUnnamed1603Label AT (3 16) USABLE FONT 0
  SCROLLBAR ID NoteScrollyScrollBar AT (146 33 7 100) USABLE VALUE 0 MIN 0 MAX 0 PAGESIZE 0
END

MENU ID MainFormMenuBar
BEGIN
  PULLDOWN "Options"
  BEGIN
    MENUITEM "Quit Kronos" ID MainOptionsQuitKronos "Q"
    MENUITEM "About Kronos" ID MainOptionsAboutKronos
  END
  PULLDOWN "Game"
  BEGIN
    MENUITEM "Load" ID GameLoad "L"
    MENUITEM "Save" ID GameSave "R"
    MENUITEM SEPARATOR ID 1202
    MENUITEM "Zoom Picture" ID GameZoomPicture "Z"
    MENUITEM SEPARATOR ID 1204
    MENUITEM "Automap Exits" ID GameAutomapExits "E"
    MENUITEM "Automap View" ID GameAutomapView "V"
    MENUITEM SEPARATOR ID 1207
    MENUITEM "Add Game Notes" ID GameAddGameNotes "A"
    MENUITEM SEPARATOR ID 1209
    MENUITEM "Quit" ID GameQuit "K"
  END
  PULLDOWN "Edit"
  BEGIN
    MENUITEM "Undo" ID EditUndo "U"
    MENUITEM "Cut" ID EditCut "X"
    MENUITEM "Copy" ID EditCopy "C"
    MENUITEM "Paste" ID EditPaste "P"
    MENUITEM "Select All" ID EditSelectAll "S"
    MENUITEM SEPARATOR ID 1105
    MENUITEM "Keyboard" ID EditKeyboard "K"
    MENUITEM "Graffiti" ID EditGrafitti "G"
    MENUITEM SEPARATOR ID 1108
    MENUITEM "Free Heap RAM" ID EditFreeHeapRAM
  END
  PULLDOWN "Colour"
  BEGIN
    MENUITEM "Atari ST" ID ColourAtariST
    MENUITEM "BlackOnWhite" ID ColourBlackOnWhite
    MENUITEM "Commodore Amiga" ID ColourCommodoreAmiga
    MENUITEM "Commodore Vic 20" ID ColourCommodoreVic20
    MENUITEM "MS DOS" ID ColourMSDOS
  END
END

ALERT ID RomIncompatibleAlert ERROR DEFAULTBUTTON 0
BEGIN
  TITLE "System Incompatible"
  MESSAGE "System Version 4.0 or greater is required to run this application."
  BUTTONS "OK"
END

ALERT ID MessageAlert INFORMATION DEFAULTBUTTON 0
BEGIN
  TITLE "Message"
  MESSAGE "^1"
  BUTTONS "OK"
END

ALERT ID YesNoAlert CONFIRMATION DEFAULTBUTTON 0
BEGIN
  TITLE "Message"
  MESSAGE "^1"
  BUTTONS "Yes" "No"
END
