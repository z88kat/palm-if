/*
 * Kronos resources (PilRC).
 *
 * Converted from the original CodeWarrior Constructor file; the IDs are
 * defined in KronosRsc.h, which the C sources include as well.
 */

#include "KronosRsc.h"

APPLICATIONICONNAME ID 1000 "Kronos"
VERSION ID 1000 "1.5"

/* ARM native helper for the picture viewer (built from src/arm) */
DATA "ARMC" ID 1001 "picview.bin"

ICON ID 1000
BEGIN
  BITMAP "bitmaps/pict_1001.bmp" BPP 1 
  BITMAP "bitmaps/pict_1002_c.bmp" BPP 2 
  BITMAP "bitmaps/pict_1008_c.bmp" BPP 8 TRANSPARENTINDEX 210
  BITMAP "bitmaps/icon_hd_1009_c.bmp" BPP 16 TRANSPARENT 128 255 128 DENSITY 144
END

SMALLICON ID 1001
BEGIN
  BITMAP "bitmaps/pict_1011.bmp" BPP 1 
  BITMAP "bitmaps/pict_1012_c.bmp" BPP 2 
  BITMAP "bitmaps/pict_1018_c.bmp" BPP 8 TRANSPARENTINDEX 204
END

